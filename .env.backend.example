# ==============================================
# BACKEND CONFIGURATION (apps/error-service)
# ==============================================
PORT=3000
NODE_ENV=development

# Database (PostgreSQL & Prisma ORM)
DATABASE_URL="postgresql://<username>:<password>@<IP>:<port>/<nama_database>?schema=public"
DIRECT_URL="postgresql://<username>:<password>@<IP>:<port>/<nama_database>?schema=public"

# JWT Authentication
JWT_SECRET=<jwt_secret_key>
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=<jwt_refresh_secret_key>
JWT_REFRESH_EXPIRES_IN=1d

# CORS (Allowed Origin from Frontend)
FRONTEND_URL=http://<IP>:<port>

# RabbitMQ (Event bus: error-service → n8n → Telegram)
# Kosongkan RABBITMQ_URL untuk mode dev tanpa notifikasi (publish dilewati + warning)
RABBITMQ_URL=amqp://<username>:<password>@<IP>:<port>
RABBITMQ_EXCHANGE=erad.events
