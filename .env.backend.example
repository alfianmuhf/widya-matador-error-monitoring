# ==============================================
# BACKEND CONFIGURATION (apps/error-service)
# ==============================================
PORT=3000
NODE_ENV=development

# Database (PostgreSQL & Prisma ORM)
DATABASE_URL="postgresql://<username>:<password>@<IP>:<port>/<nama_database>?schema=public"
DIRECT_URL="postgresql://<username>:<password>@<IP>:<port>/<nama_database>?schema=public"

# JWT Authentication
JWT_SECRET=<jwt_secret_key>
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=<jwt_refresh_secret_key>
JWT_REFRESH_EXPIRES_IN=1d

# CORS (Allowed Origin from Frontend)
FRONTEND_URL=http://<IP>:<port>

# RabbitMQ (Event bus: error-service → n8n → Telegram)
# Kosongkan RABBITMQ_URL untuk mode dev tanpa notifikasi (publish dilewati + warning)
RABBITMQ_URL=amqp://<username>:<password>@<IP>:<port>
RABBITMQ_EXCHANGE=erad.events

# Object Storage (S3-compatible: RustFS / MinIO / R2 / S3) — lampiran tiket
# Kosongkan S3_BUCKET untuk menonaktifkan upload lampiran (endpoint mengembalikan 503)
# Untuk Docker Compose gunakan DNS service `rustfs`; ganti untuk storage eksternal.
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=erad-attachments
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=<secret_key>
# RustFS/MinIO/SeaweedFS wajib path-style; AWS S3/R2 gunakan false
S3_FORCE_PATH_STYLE=true

# Redis Cache (opsional — tanpa Redis sistem tetap jalan, cache dilewati)
# Untuk Docker Compose gunakan DNS service `redis`; ganti untuk Redis eksternal.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=masukkan_pw
