# ==============================================
# BACKEND CONFIGURATION (apps/error-service)
# ==============================================
PORT=3000
NODE_ENV=development

# Database (PostgreSQL & Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/widya_matador_error_monitoring?schema=public"

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=1d

# CORS (Allowed Origin from Frontend)
FRONTEND_URL=http://localhost:5173

# RabbitMQ (event bus: error-service → n8n → Telegram)
# Kosongkan untuk mode dev tanpa notifikasi (publish dilewati + warning)
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=erad.events







