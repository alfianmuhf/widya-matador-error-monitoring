// ERAD — Error Report Automation Dashboard
// Prisma schema, disesuaikan 1:1 dengan perubahan_DB.dbml (tabel & kolom snake_case)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================================================
// 1. ENUM
// ==================================================

enum user_role {
  admin
  coordinator
  viewer
}

enum user_status {
  invited
  active
  suspended
}

enum division {
  none
  after_sales
  software
}

enum bot_state {
  idle
  await_asset
  await_component
  await_failure_code
  await_detail
  await_update
  committed
}

enum delete_type {
  none
  soft
  hard
}

enum export_status {
  queued
  processing
  ready
  failed
}

enum asset_type {
  portable
  static
}

enum asset_status {
  active
  maintenance
  retired
}

enum telegram_group_type {
  client
  location
  internal
}

enum ticket_status {
  open
  escalated
  solved
}

enum severity {
  rendah
  sedang
  tinggi
}

// ==================================================
// 2. USER & TELEGRAM USER (+ tabel pendukungnya)
// ==================================================

model users {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegram_user_id      String?     @unique @db.Uuid
  email                 String      @unique @db.VarChar(100)
  name                  String      @db.VarChar(100)
  password_hash         String
  role                  user_role   @default(viewer)
  division              division?
  status                user_status @default(invited)
  must_change_password  Boolean     @default(true)
  failed_login_attempts Int         @default(0)
  locked_until          DateTime?   @db.Timestamptz
  last_login_at         DateTime?   @db.Timestamptz
  password_changed_at   DateTime?   @db.Timestamptz
  created_at            DateTime    @default(now()) @db.Timestamptz
  updated_at            DateTime    @default(now()) @updatedAt @db.Timestamptz

  telegram_user    telegram_users?    @relation(fields: [telegram_user_id], references: [id], onDelete: SetNull)
  refresh_tokens   refresh_tokens[]
  export_jobs      export_jobs[]
  audit_logs       audit_logs[]
  ticket_history   ticket_history[]
  ticket_assignees ticket_assignees[]
  created_tickets  tickets[]          @relation("ticket_aftersales_user")
}

model telegram_users {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegram_id String?    @unique @db.VarChar(50)
  username    String?    @db.VarChar(100)
  full_name   String?    @db.VarChar(100)
  is_active   Boolean    @default(true)
  division    division?
  created_at  DateTime   @default(now()) @db.Timestamptz
  updated_at  DateTime   @default(now()) @updatedAt @db.Timestamptz

  user           users?
  bot_sessions   bot_sessions?
  audit_logs     audit_logs[]
  ticket_history ticket_history[]
}

model bot_sessions {
  telegram_id  String     @id @db.VarChar(50)
  state        bot_state?
  session_data Json?
  created_at   DateTime   @default(now()) @db.Timestamptz
  updated_at   DateTime   @default(now()) @updatedAt @db.Timestamptz
  expires_at   DateTime?  @db.Timestamptz

  telegram_user telegram_users @relation(fields: [telegram_id], references: [telegram_id], onDelete: Cascade)
}

model telegram_events {
  update_id    BigInt   @id
  processed_at DateTime @default(now()) @db.Timestamptz
}

model refresh_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token_hash String    @unique
  user_id    String    @db.Uuid
  expires_at DateTime  @db.Timestamptz
  revoked_at DateTime? @db.Timestamptz
  user_agent String?
  ip_address String?
  created_at DateTime  @default(now()) @db.Timestamptz

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model audit_logs {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_name             String?     @db.VarChar(100)
  actor_user_id          String?     @db.Uuid
  actor_telegram_user_id String?     @db.Uuid
  delete_type            delete_type @default(none)
  action                 String?     @db.VarChar(20)
  entity_type            String?     @db.VarChar(50)
  entity_id              String?     @db.VarChar(50)
  details                Json?
  ip_address             String?
  created_at             DateTime    @default(now()) @db.Timestamptz

  user          users?          @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)
  telegram_user telegram_users? @relation(fields: [actor_telegram_user_id], references: [id], onDelete: SetNull)

  @@index([entity_type, entity_id])
  @@index([created_at])
}

model export_jobs {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requested_by_user_id String        @db.Uuid
  status               export_status @default(queued)
  filters              Json?
  file_url             String?
  error_message        String?
  completed_at         DateTime?     @db.Timestamptz
  expires_at           DateTime?     @db.Timestamptz
  created_at           DateTime      @default(now()) @db.Timestamptz
  updated_at           DateTime      @default(now()) @updatedAt @db.Timestamptz

  user users @relation(fields: [requested_by_user_id], references: [id], onDelete: Cascade)
}

// ==================================================
// 3. MASTER DATA
// ==================================================

model clients {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique @db.VarChar(100)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  assets          assets[]
  telegram_groups telegram_groups[]
}

model locations {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique @db.VarChar(100)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  assets          assets[]
  telegram_groups telegram_groups[]
}

model assets {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_code          String       @unique @db.VarChar(50)
  asset_type         asset_type   @default(portable)
  client_id          String       @db.Uuid
  location_id        String       @db.Uuid
  status             asset_status @default(active)
  commissioning_date DateTime?    @db.Date
  is_active          Boolean      @default(true)
  created_at         DateTime     @default(now()) @db.Timestamptz
  updated_at         DateTime     @default(now()) @updatedAt @db.Timestamptz

  client   clients   @relation(fields: [client_id], references: [id], onDelete: Restrict)
  location locations @relation(fields: [location_id], references: [id], onDelete: Restrict)
  tickets  tickets[]

  @@index([client_id])
  @@index([location_id])
}

model components {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prefix     String   @unique @db.VarChar(10)
  name       String   @unique @db.VarChar(100)
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  failure_codes failure_codes[]
}

model failure_codes {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  component_id String   @db.Uuid
  code         String   @db.VarChar(20)
  name         String?  @db.VarChar(100)
  description  String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz

  component components @relation(fields: [component_id], references: [id], onDelete: Restrict)
  tickets   tickets[]

  @@unique([component_id, code])
}

model telegram_groups {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_id     String               @unique @db.VarChar(50)
  name        String?              @db.VarChar(100)
  group_type  telegram_group_type?
  client_id   String?              @db.Uuid
  location_id String?              @db.Uuid
  is_active   Boolean              @default(true)
  created_at  DateTime             @default(now()) @db.Timestamptz
  updated_at  DateTime             @default(now()) @updatedAt @db.Timestamptz

  client   clients?   @relation(fields: [client_id], references: [id], onDelete: SetNull)
  location locations? @relation(fields: [location_id], references: [id], onDelete: SetNull)
}

// ==================================================
// 4. TIKET
// ==================================================

model tickets {
  id                 String   @id @db.VarChar(50)
  asset_id           String   @db.Uuid
  failure_code_id    String   @db.Uuid
  aftersales_user_id String   @db.Uuid
  current_version    Int      @default(1)
  open_at            DateTime  @default(now()) @db.Timestamptz
  escalated_at       DateTime? @db.Timestamptz
  solved_at          DateTime? @db.Timestamptz
  leader_assignee_id String?   @unique @db.Uuid

  asset           assets            @relation(fields: [asset_id], references: [id], onDelete: Restrict)
  failure_code    failure_codes     @relation(fields: [failure_code_id], references: [id], onDelete: Restrict)
  aftersales_user users             @relation("ticket_aftersales_user", fields: [aftersales_user_id], references: [id], onDelete: Restrict)
  leader_assignee ticket_assignees? @relation("ticket_leader_assignee", fields: [leader_assignee_id], references: [id], onDelete: SetNull)

  ticket_history   ticket_history[]
  ticket_assignees ticket_assignees[] @relation("ticket_assignee_list")

  @@index([asset_id])
  @@index([failure_code_id])
  @@index([aftersales_user_id])
  @@index([open_at])
}

model ticket_history {
  id                          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id                   String        @db.VarChar(50)
  version                     Int
  status                      ticket_status @default(open)
  damage_description          String?
  action_taken                String?
  root_cause                  String?
  severity                    severity      @default(rendah)
  notes                       String?
  changed_by_user_id          String?       @db.Uuid
  changed_by_telegram_user_id String?       @db.Uuid
  changed_at                  DateTime      @default(now()) @db.Timestamptz

  ticket              tickets         @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  changed_by_user     users?          @relation(fields: [changed_by_user_id], references: [id], onDelete: Restrict)
  changed_by_telegram telegram_users? @relation(fields: [changed_by_telegram_user_id], references: [id], onDelete: Restrict)

  @@unique([ticket_id, version])
  @@index([status, changed_at])
}

// ==================================================
// 5. GROUP SOFTWARE (claim tiket)
// ==================================================

model ticket_assignees {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id  String   @db.VarChar(50)
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  ticket      tickets  @relation("ticket_assignee_list", fields: [ticket_id], references: [id], onDelete: Cascade)
  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lead_ticket tickets? @relation("ticket_leader_assignee")

  @@unique([ticket_id, user_id])
  @@index([user_id])
}
